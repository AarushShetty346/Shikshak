# Copy to .env and fill in. Never commit .env. Every value here is optional in development;
# production needs TOOLS_TOKEN (see docs/DEPLOYMENT.md).

# ---------- server ----------
PORT=8787
# Where learners, classes and records are kept (one JSON file per record). On a host without a
# persistent disk (Render free) everything is lost on each deploy or restart.
DATA_DIR=data
# Public HTTPS URL of this server. Bolna calls the board tools here.
PUBLIC_URL=https://your-tunnel-or-deploy.example.com
# Extra browser origins allowed to open the class WebSocket, comma separated (same origin is always allowed).
ALLOWED_ORIGINS=

# ---------- secrets for the voice agent's tools ----------
# Required in production: Bolna sends "Authorization: Bearer <TOOLS_TOKEN>" on every tool call.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Set the SAME value here (for npm run bolna:setup) and on the server, then re-run bolna:setup.
TOOLS_TOKEN=
# Operator endpoints (/api/admin/*, e.g. placing a phone revision call). Off when empty.
ADMIN_TOKEN=
# Only for npm run tour:voice (records the tour once in the tutor's voice). Not needed on the server.
SARVAM_API_KEY=

# ---------- handwriting checker and lesson plans ----------
# Gemini has a free tier (aistudio.google.com). Claude is used only when GEMINI_API_KEY is empty.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3-flash-preview
# GEMINI_FALLBACKS=gemini-3.5-flash,gemini-3.6-flash,gemini-flash-latest
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# Development only: a fake checker when no model key is set (labelled as such in the app).
# FAKE_CHECKER=1

# ---------- voice (Bolna) ----------
BOLNA_API_KEY=
# Created by npm run bolna:setup.
BOLNA_AGENT_ID=
# Languages the agents were set up with. Add ta,te only after bolna:setup has pushed them.
BOLNA_AGENT_LANGUAGES=hi,en
# For model comparisons only (npm run bench:models). Not used by the app.
# OPENAI_API_KEY=

# ---------- limits (defaults shown) ----------
# VOICE_MINUTES_PER_OWNER_PER_DAY=60
# VOICE_MINUTES_PER_DAY=240            (whole server)
# VOICE_MAX_CALL_MINUTES=20
# VOICE_MAX_CONCURRENT_PER_OWNER=1
# VOICE_MAX_CONCURRENT=2               (whole server)
# MODEL_CALLS_PER_OWNER_PER_DAY=400
# PLANS_PER_OWNER_PER_DAY=25

# ---------- phone revision calls (off by default; see docs/DEPLOYMENT.md) ----------
PHONE_CALLS_ENABLED=
# Created by npm run bolna:setup -- --phone
BOLNA_PHONE_AGENT_ID=
# E.164 numbers an operator has approved, comma separated.
PHONE_ALLOWLIST=
# PHONE_MAX_CALLS_PER_NUMBER_PER_DAY=1
# PHONE_MAX_CONCURRENT=1
# PHONE_MAX_CALL_SECONDS=300
