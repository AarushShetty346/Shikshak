# Server port
PORT=8787

# Reads the student's handwriting and makes lesson plans. Set one of these.
# Gemini has a free tier: aistudio.google.com -> Get API key
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# Claude (paid), used only when GEMINI_API_KEY is empty
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# Bolna (voice). Get these from platform.bolna.ai
BOLNA_API_KEY=
BOLNA_AGENT_ID=

# Public HTTPS URL of this server (tunnel or deploy). Used to print the Bolna tool JSON.
PUBLIC_URL=https://your-tunnel-or-deploy.example.com

# Optional shared secret. If set, Bolna tool calls must send "Authorization: Bearer <TOOLS_TOKEN>".
TOOLS_TOKEN=
