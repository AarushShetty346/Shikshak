{
  "name": "shikshak",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Voice maths tutor that talks, writes on a board, and checks your handwritten work. Bolna Buildathon 2026.",
  "author": "Aarush Shetty (https://github.com/AarushShetty346)",
  "repository": "github:AarushShetty346/Shikshak",
  "scripts": {
    "dev": "tsx server/index.ts",
    "dev:watch": "tsx watch --ignore \"web/**\" server/index.ts",
    "build": "vite build",
    "start": "tsx server/index.ts --prod",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "bolna:tools": "tsx scripts/print-bolna-tools.ts",
    "bolna:setup": "tsx scripts/setup-bolna.ts",
    "eval:checker": "tsx scripts/eval-checker.ts",
    "tour:voice": "tsx scripts/tour-voice.ts",
    "bolna:model": "tsx scripts/llm-model.ts",
    "bench:calls": "tsx scripts/bench/calls.ts",
    "bench:models": "tsx scripts/bench/models.ts",
    "lint": "oxlint server shared web/src scripts e2e --deny-warnings",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@bolna/web-call": "^3.0.1",
    "@fontsource/kalam": "^5.3.0",
    "@fontsource/mukta": "^5.3.0",
    "@google/genai": "^2.30.0",
    "@phosphor-icons/react": "^2.1.10",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
